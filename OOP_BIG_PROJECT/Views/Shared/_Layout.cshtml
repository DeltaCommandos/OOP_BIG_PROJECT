<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Дуэлянт+</title>
    <link rel="icon" type="image/x-icon" href="/логос1.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OOP_BIG_PROJECT.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    


    <header class="py-3 mb-3">
        <div class="container-fluid d-grid gap-3 align-items-center" style="grid-template-columns: 1fr 2fr;">
            <div class="dropdown duel3">
                <a href="/" class="d-flex align-items-center col-lg-4 mb-2 mb-lg-0 link-body-emphasis text-decoration-none logo" id="homeButton">
                    <img src="/Duelant.png" alt="image" border="0" width="140" height="60">
                </a>
            </div>

            <div class="d-flex align-items-center">
                

                <div class="flex-shrink-0 dropdown achom3">
                    @if (StaticStuff.Fighter != null)
                    {
                        <a asp-controller="Account" asp-action="AccountHome" class="avaMini d-block link-body-emphasis text-decoration-none" type="button" id="accountButton">
                            <div>

                                <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                                </svg>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>







    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script>
        // Проверка состояния пользователя на сервере
        $(document).ready(function () {
            // Если пользователь авторизован, показываем кнопку 2
            var isAuthenticated = @StaticStuff.Fighter != null ? true : false;

            if (isAuthenticated) {
                $('#accountButton').show();
            } else {
                $('#accountButton').hide();
            }

            // Когда нажимаем на кнопку 1, скрываем кнопку 2
            $('#homeButton').on('click', function () {
                $('#accountButton').hide();
            });
        });
    </script>
</body>
</html>
