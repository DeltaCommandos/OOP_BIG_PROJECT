<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Дуэлянт+</title>
    <link rel="icon" type="image/x-icon" href="/логос1.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OOP_BIG_PROJECT.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <header>
        <a href="/" id="homeButton">
            <img src="https://i.ibb.co/j38Q9Mc/image.png" alt="image" border="0" width="120" height="50">
        </a>

        @if (StaticStuff.Fighter != null)
        {
            <a asp-controller="Account" asp-action="AccountHome" class="d-inline-flex align-items-center btn btn-lg px-4 rounded-pill text-white" type="button" id="accountButton">
                <div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                    </svg>
                </div>
                <svg class="bi ms-2" width="100" height="50"><use xlink:href="#arrow-right-short"></use></svg>
            </a>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script>
        // Проверка состояния пользователя на сервере
        $(document).ready(function () {
            // Если пользователь авторизован, показываем кнопку 2
            var isAuthenticated = @StaticStuff.Fighter != null ? true : false;

            if (isAuthenticated) {
                $('#accountButton').show();
            } else {
                $('#accountButton').hide();
            }

            // Когда нажимаем на кнопку 1, скрываем кнопку 2
            $('#homeButton').on('click', function () {
                $('#accountButton').hide();
            });
        });
    </script>
</body>
</html>
