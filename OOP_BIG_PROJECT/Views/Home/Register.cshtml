@model OOP_BIG_PROJECT.ViewModels.RegisterViewModel


<div class="login1">

    <form asp-action="Register" class="p-4 p-md-5 bg-body-tertiary">
        <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3 text-light">Регистрация</h1>

        <div class="form-floating mb-3 text-black" width="70%">
            <input type="text" class="form-control" id="floatingInput" asp-for="Username" required> <span asp-validation-for="Username" class="text-danger"></span>
            <label for="floatingInput text-black">Никнейм</label>
        </div>
        @if (Model.IsUserExisting)
        {
            <div>
                Такой пользователь уже существует!
            </div>
        }

        <div class="form-floating mb-3 text-black" width="70%">
            <input type="password" class="form-control" id="floatingPassword" asp-for="Password" required> <span asp-validation-for="Password" class="text-danger"></span>
            <label for="floatingPassword text-black">Пароль</label>
        </div>


        <hr class="my-4">

        <button class="w-100 btn btn-lg btn-warning" type="submit">Зарегестрироваться</button>

        <hr class="my-4">

        <a asp-controller="Home" asp-action="Login" style="color:lightgreen" type="text">
            Уже есть аккаунт?
        </a>

    </form>
</div>

