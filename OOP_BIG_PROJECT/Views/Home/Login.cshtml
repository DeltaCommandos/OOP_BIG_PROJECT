@model OOP_BIG_PROJECT.ViewModels.UserViewModel



 <div class="login1">

    <form asp-action="Login" class="p-4 p-md-5 bg-body-tertiary">
        <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3 text-light">Вход</h1>
        <div class="form-floating mb-3">
            <input type="text" class="form-control text-black" id="floatingInput" asp-for="Username">
            <label class="text-black" for="floatingInput">Никнейм</label>
        </div>
        @if (!Model.IsUserExisting)
        {
            <div>
                Пользователь не найден! 
            </div>
        }

        <div class="form-floating mb-3">
            <input type="password" class="form-control text-black" id="floatingPassword" asp-for="Password1">
            <label class="text-black" for="floatingPassword">Пароль</label>
        </div>
        
        @if (!Model.IsPasswordCorrect)
        {
            <div>
                Неправильный пароль!
            </div>
        }

        <hr class="my-4">

        <button class="w-100 btn btn-lg btn-warning" type="submit">Войти</button>
       
        <hr class="my-4">

        <a asp-controller="Home" asp-action="Register" type="text" style="color:lightgreen">
            Зарегистрироваться
        </a>

    </form>
</div>




