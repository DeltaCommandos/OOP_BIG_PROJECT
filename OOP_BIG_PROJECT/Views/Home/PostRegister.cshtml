@model OOP_BIG_PROJECT.ViewModels.RegisterViewModel

<div class="fighter1">
    <form asp-action="PostRegister" class="p-4 p-md-5 bg-body-tertiary">

        <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3 text-light">Введите личную информацию</h1>
        <hr class="my-4">

        <!-- Возраст -->
        <div class="form-group row align-items-center fig3">
            <h2 class="col-sm-2">Возраст</h2>
            <div class="col-sm-4 ">
                <input type="number" min="14" max="999" class="form-control ager" id="floatingInput" asp-for="Age">
            </div>
            <h2 class="col-sm-2">Пол</h2>
            <div class="col-sm-4">
                <label class="switch">
                    <input type="checkbox" id="sexSwitch" name="Sex">
                    <span class="slider round"></span>
                    14
                </label>
                <span id="sexLabel" class="d-inline-block ml-2 sexlab">Мужской</span>
            </div>

        </div>

        <!-- Пол -->
@*         <div class="form-group row align-items-center">
        </div>

 *@   
        <div class="chooseTags">
            <h2 class="hohohehe">Теги, по которым вас можно будет найти</h2>

            <div class="form-group">
                <label for="TagId1">Тег 1</label>
                <select asp-for="TagId1" asp-items="Model.AvailableTags" class="form-control TagBox">
                    <option value="" title="">Выберите тег</option>
                </select>
            </div>
            <div class="form-group">
                <label for="TagId2">Тег 2</label>
                <select asp-for="TagId2" asp-items="Model.AvailableTags" class="form-control TagBox">
                    <option value="">Выберите тег</option>
                </select>
            </div>
            <div class="form-group">
                <label for="TagId3">Тег 3</label>
                <select asp-for="TagId3" asp-items="Model.AvailableTags" class="form-control TagBox">
                    <option value="">Выберите тег</option>
                </select>
            </div>
            <div class="form-group">
                <label for="TagId4">Тег 4</label>
                <select asp-for="TagId4" asp-items="Model.AvailableTags" class="form-control TagBox">
                    <option value="">Выберите тег</option>
                </select>
            </div>
            <div class="form-group">
                <label for="TagId5">Тег 5</label>
                <select asp-for="TagId5" asp-items="Model.AvailableTags" class="form-control TagBox">
                    <option value="">Выберите тег</option>
                </select>
            </div>

        </div>

        <!-- Описание (широкое поле) -->
        <h2 class="hohohehe zag">Описание</h2>
        <div class="form-floating mb-3">
            <textarea class="form-control wide-input" id="floatingInput" asp-for="Skills"></textarea>
        </div>

        <hr class="my-4">
        <button class="w-100 btn btn-lg btn-warning" type="submit">Сохранить</button>
    </form>
</div>







<script>
    document.getElementById('sexSwitch').addEventListener('change', function () {
        if (this.checked) {
            this.value = true; // Женский
            document.getElementById('sexLabel').textContent = 'Женский';
        } else {
            this.value = false; // Мужской
            document.getElementById('sexLabel').textContent = 'Мужской';
        }
    });

    function removeTagWithId2() {
        // Найдем все выпадающие списки с классом 'TagBox'
        const tagSelects = document.querySelectorAll('.TagBox');

        // Для каждого выпадающего списка
        tagSelects.forEach(select => {
            // Найдем опцию с value="2"
            const optionToRemove = select.querySelector('option[value="2"]');

            // Если такая опция существует, удалим ее
            if (optionToRemove) {
                select.removeChild(optionToRemove);
            }
        });
    }

    // Выполним функцию после загрузки страницы
    document.addEventListener('DOMContentLoaded', removeTagWithId2);

</script>


<script>
    $(document).ready(function () {
        // Если мы на странице PostRegister, скрываем кнопку с классом achom3
        if (window.location.pathname.includes('PostRegister')) {
            $('.achom3').css('display', 'none'); // Скрывает элемент с классом achom3
        }

        // Отключение действия кнопки duel3
        $('.duel3 a').on('click', function (e) {
            e.preventDefault(); // Останавливаем действие кнопки
        });
    });
</script>
