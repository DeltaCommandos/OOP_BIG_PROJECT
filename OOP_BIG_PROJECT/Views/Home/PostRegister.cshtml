@model OOP_BIG_PROJECT.ViewModels.RegisterViewModel


<div class="fighter1">
    <div class="scroll">
        <form asp-action="PostRegister" class="p-4 p-md-5 bg-body-tertiary">
            <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3 text-light">Введите личную информацию</h1>


            <h2>Возраст</h2>
            <div class="form-floating mb-3 ">
                <input type="number" min="14" max="999" class="form-control" id="floatingInput" asp-for="Age">
            </div>

            <h2>Пол</h2>
            <p>
                <input type="radio" value="false" checked name="Sex" />мужской
            </p>
            <p>
                <input type="radio" value="true" name="Sex" />женский
            </p>

            <h2>Описание</h2>
 
            <div class="form-floating mb-3 skills">
                <input type="text" class="form-control" id="floatingInput" asp-for="Skills">
            </div>


            <h2>Теги, по которым вас можно будет найти</h2>
            <div class="chooseTags">

            </div>


            <hr class="my-4">

            <button class="w-100 btn btn-lg btn-warning" type="submit">Сохранить</button>
            

            
        </form>
    </div>
</div>