@model OOP_BIG_PROJECT.ViewModels.TagsViewModel


<div class="tabler1">
    <form asp-action="Back" method="get">
        <button type="submit" class="boba">
            <svg xmlns="http://www.w3.org/2000/svg" width="46" height="36" fill="currentColor" class="bi bi-arrow-left-circle" viewBox="0 0 16 16" style="color:white">
                <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-4.5-.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
        </button>
    </form>


    <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3 text-center txer">Список тегов</h1>




    <div class="scroll-ban" style="max-height: 400px; overflow-y: auto; color: white;">
        <table class="table table-striped text-center" style="color:white">
            <thead>
                <tr>
                    <th>Название тега</th>
                    <th>Описание тега</th>
                    <th>Изменить</th>
                    <th>Удалить</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tag in Model.AllTags)
                {
                    <tr>
                        <td style="color:white">@tag.Name</td>
                        <td style="color:white">@tag.Description</td>
                        <td style="color:white">
                            <form asp-action="TagChange" method="get">
                                <input type="hidden" name="Id" value="@tag.Id"/>
                                <button type="submit" class="btn btn-primary" class="d-inline-flex align-items-center btn btn-lg px-4 rounded-pill" title="Редактировать тег">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                        <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                        <td style="color:white">
                            <form asp-action="TagDelete" method="post">
                                <input type="hidden" name="TagId" value="@tag.Id" />
                                <button type="submit" class="btn btn-warning" class="d-inline-flex align-items-center btn btn-lg px-4 rounded-pill" title="Удалить чат">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                    <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                                </svg>
                            </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


</div>
