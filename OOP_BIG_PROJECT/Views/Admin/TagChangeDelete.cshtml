<div class="tabler1">
    <form asp-action="Back" method="get">
        <button type="submit" class="boba">
            <svg xmlns="http://www.w3.org/2000/svg" width="46" height="36" fill="currentColor" class="bi bi-arrow-left-circle" viewBox="0 0 16 16" style="color:white">
                <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-4.5-.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
        </button>
    </form>

    <div style="max-height: 400px; overflow-y: auto; color: white;">
        <table class="table table-striped text-center" style="color:white">
            <thead>
                <tr>
                    <th>Название тега</th>
                    <th>Описание тега</th>
                    <th>Изменить</th>
                    <th>Удалить</th>
                </tr>
            </thead>
            <tbody class="scroll_table">
                @foreach (var tag in Model.AllTags)
                {
                    <tr>
                        <td>@tag.Name</td>
                        <td>@tag.Description</td>
                        <td>
                            <form asp-action="TagChange" method="get">
                                <input type="hidden" name="Id" value="@tag.Id" />
                                <button type="submit" class="btn btn-primary d-inline-flex align-items-center btn-lg px-4 rounded-pill">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-dots-fill" viewBox="0 0 16 16"></svg>
                                </button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="TagDelete" method="post">
                                <input type="hidden" name="TagId" value="@tag.Id" />
                                <button type="submit" class="btn btn-warning d-inline-flex align-items-center btn-lg px-4 rounded-pill">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16"></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


</div>
