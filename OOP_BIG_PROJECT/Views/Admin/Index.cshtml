@* model OOP_BIG_PROJECT.ViewModels.UserViewModel *@

<div class="admin3">
    <div class="p-5 text-center bg-body-tertiary rounded-3">
        <img src="https://i.ibb.co/j38Q9Mc/image.png" alt="image" border="0" width="120" height="50">
        <hr class="my-4">


        <div class="ArButs">
            <div class="d-inline-flex gap-2 mb-5">
                <a asp-controller="Admin" asp-action="TagMenu" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Работа с тегами
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-tags-fill" viewBox="0 0 16 16">
                        <path d="M2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586zm3.5 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3" />
                        <path d="M1.293 7.793A1 1 0 0 1 1 7.086V2a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l.043-.043z" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="ArButs">
            <div class="d-inline-flex gap-2 mb-5">
                <a asp-controller="Admin" asp-action="Ban" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Изменить участников
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                    </svg>
                </a>
            </div>
        </div>

    </div>
</div>
