@model OOP_BIG_PROJECT.ViewModels.UserViewModel

<div class="login3">


    <div class="p-5 text-center bg-body-tertiary rounded-3">
        <div class="avaMax">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
            </svg>
        </div>

        <h3 class="fw-bold text-body-emphasis text-center">
            @StaticStuff.Fighter.Name
        </h3>

        <hr class="my-4">

        
        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
            <div class="d-inline-flex gap-2 mb-5 ArButs whatLike0">
                <a asp-controller="Account" asp-action="ChangeLoginAndPassword" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Изменить информацию
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                        <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z" />
                    </svg>
                </a>
            </div>

            <div class="d-inline-flex gap-2 mb-5 ArButs whatLike0">
                <a asp-controller="Account" asp-action="MyInfo" class=" qq1 d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Обо мне
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7" />
                    </svg>
                </a>
            </div>
        </div>


        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
            <div class="d-inline-flex gap-2 mb-5 ArButs whatLike">
                <a asp-controller="Likers" asp-action="Index" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Кто мной заинтересовался?
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-hand-thumbs-up-fill" viewBox="0 0 16 16">
                        <path d="M6.956 1.745C7.021.81 7.908.087 8.864.325l.261.066c.463.116.874.456 1.012.965.22.816.533 2.511.062 4.51a10 10 0 0 1 .443-.051c.713-.065 1.669-.072 2.516.21.518.173.994.681 1.2 1.273.184.532.16 1.162-.234 1.733q.086.18.138.363c.077.27.113.567.113.856s-.036.586-.113.856c-.039.135-.09.273-.16.404.169.387.107.819-.003 1.148a3.2 3.2 0 0 1-.488.901c.054.152.076.312.076.465 0 .305-.089.625-.253.912C13.1 15.522 12.437 16 11.5 16H8c-.605 0-1.07-.081-1.466-.218a4.8 4.8 0 0 1-.97-.484l-.048-.03c-.504-.307-.999-.609-2.068-.722C2.682 14.464 2 13.846 2 13V9c0-.85.685-1.432 1.357-1.615.849-.232 1.574-.787 2.132-1.41.56-.627.914-1.28 1.039-1.639.199-.575.356-1.539.428-2.59z" />
                    </svg>
                </a>
            </div>

            <div class="d-inline-flex gap-2 mb-5 ArButs whatLike">
                <a asp-controller="Account" asp-action="ViewMatches" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Взаимные симпатии
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
            <div class="d-inline-flex gap-2 mb-5 ArButs whatLike4">
                <a asp-controller="Match" asp-action="Index" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Продолжить поиск
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </a>
            </div>

            <div class="d-inline-flex gap-2 mb-5 ArButs whatLike4">
                <a asp-controller="Account" asp-action="Blacklist" class="d-inline-flex align-items-center justify-content-between btn btn-success btn-lg px-4 rounded-pill align-content-center" type="button">
                    Черный список
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </a>
            </div>
        </div>

        


     </div>
</div>
