@model OOP_BIG_PROJECT.ViewModels.FighterViewModel

<div class="login3">


    <div class="p-5 text-center bg-body-tertiary rounded-3">
        <td>
            <div class="avaMax">
                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                </svg>
            </div>

        </td>
        <td>
            <form asp-controller="Account" asp-action="MyInfo" method="get">

                    @if (Model.FighterId != null)
        {

            <h3 class="fw-bold text-body-emphasis text-center">
                @StaticStuff.Fighter.Name
            </h3>

            <div class="tag-container">
                @if (Model.SelectedTag1 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedTag1)
                        {
                            <span class="tag t1">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedTag2 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId2)
                        {
                            <span class="tag t2">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedTag3 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId3)
                        {
                            <span class="tag t3">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedTag4 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId4)
                        {
                            <span class="tag t4">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedTag5 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId5)
                        {
                            <span class="tag t5">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedTag1 == 2 && Model.SelectedTag2  == 2 && Model.SelectedTag3 == 2 && Model.SelectedTag4 == 2 && Model.SelectedTag5 == 2)
                {
                    <b>ㅤㅤ</b>
                }
            </div>

            @if (!Model.SelectedFighter.Sex)
            {
                <p class="col-lg-8 mx-auto fs-5 text-start" style="color:white">
                    мужчина - @Model.SelectedFighter.Age
                </p>
            }
            else
            {
                <p class="col-lg-8 mx-auto fs-5 text-start" style="color:white">
                    женщина - @Model.SelectedFighter.Age
                </p>
            }

            <div class="col-lg-8 mx-auto fs-5 scroll-s" style="color:white">
                @Model.SelectedFighter.Skills
            </div>
            }
            </form>
        </td>

        
</div>
