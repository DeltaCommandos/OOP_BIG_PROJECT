@model OOP_BIG_PROJECT.ViewModels.FighterViewModel

<div class="changer2 txer">
    <form asp-controller="Account" asp-action="Back" method="post">
        <button type="submit" class="boba">
            <svg xmlns="http://www.w3.org/2000/svg" width="46" height="36" fill="currentColor" class="bi bi-arrow-left-circle" viewBox="0 0 16 16" style="color:white">
                <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-4.5-.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
        </button>
    </form>

    <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3">Изменение возраста</h1>

    <form asp-action="ChangeAge" method="post">
        <div class="form-group row align-items-center fig3">
            <label class="col-sm-2 col-form-label">Возраст</label>
            <div class="col-sm-3">        
                <input type="number" min="14" max="999" class="form-control ager" id="floatingInput" asp-for="SelectedFighter.Age" style="height: 50px; font-size: 1.2em; color: black; background-color: white; width: 100%;">
            </div>
        </div>
        <button type="submit" class="btn btn-success">Сохранить изменения</button>
    </form>

    <img src="/Kot4.png" alt="image" border="0" width="140" height="140" class="kot">
</div>

