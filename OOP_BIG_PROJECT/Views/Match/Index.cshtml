@model OOP_BIG_PROJECT.ViewModels.FighterViewModel




<div class="pop_up" id="pop_up">
    <div class="pop_up_container">
        <div class="pop_up_body" id="pop_up_body">
            <div class="container">
                <h2>Выберите до пяти тегов для фильтрации бойцов</h2>

                <form asp-controller="Match" asp-action="SortedByTags" method="get">
                    <table>
                        <tr>
                            <th>Тег 1:</th>
                            <th>Тег 2:</th>
                            <th>Тег 3:</th>
                            <th>Тег 4:</th>
                            <th>Тег 5:</th>
                        </tr>

                        <tr>
                            <td>
                                <div class="form-group">
                                    <select class="form-control tagchos" id="SelectedTag1" name="SelectedTag1">
                                        <option value="">Выберите тег...</option>
                                        @foreach (var tag in Model.AllTags)
                                        {
                                            <option value="@tag.Id" title="@tag.Description">@tag.Name</option>
                                        }
                                    </select>
                                </div>

                            </td>

                            <td>
                                <div class="form-group">
                                    <select class="form-control tagchos" id="SelectedTag2" name="SelectedTag2">
                                        <option value="">Выберите тег...</option>
                                        @foreach (var tag in Model.AllTags)
                                        {
                                            <option value="@tag.Id" title="@tag.Description">@tag.Name</option>
                                        }
                                    </select>
                                </div>

                            </td>

                            <td>
                                <div class="form-group">
                                    <select class="form-control tagchos" id="SelectedTag3" name="SelectedTag3">
                                        <option value="">Выберите тег...</option>
                                        @foreach (var tag in Model.AllTags)
                                        {
                                            <option value="@tag.Id" title="@tag.Description">@tag.Name</option>
                                        }
                                    </select>
                                </div>


                            </td>

                            <td>
                                <div class="form-group">
                                    <select class="form-control tagchos" id="SelectedTag4" name="SelectedTag4">
                                        <option value="">Выберите тег...</option>
                                        @foreach (var tag in Model.AllTags)
                                        {
                                            <option value="@tag.Id" title="@tag.Description">@tag.Name</option>
                                        }
                                    </select>
                                </div>

                            </td>


                            <td>

                                <div class="form-group">
                                    <select class="form-control tagchos" id="SelectedTag5" name="SelectedTag5">
                                        <option value="">Выберите тег...</option>
                                        @foreach (var tag in Model.AllTags)
                                        {
                                            <option value="@tag.Id" title="@tag.Description">@tag.Name</option>
                                        }
                                    </select>
                                </div>
                            </td>

                        </tr>


                    </table>


                    <button type="submit" class="btn btn-primary" id="pop_up_close">Применить фильтр</button>
                </form>

               
                <button class="crossButton" id="pop_up_cancel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>


<div class="tinder1">

    <div>
        <div class="button2 beliyText" id="open_pop_up">
            <!-- Убрали <a> т.к.  кнопка является ссылкой -->
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-three-dots" viewBox="0 0 16 16">
                <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
            </svg>
        </div>
    </div>

    <form asp-action="Index" class="p-4 p-md-5 bg-body-tertiary tinder11">
       
        @if (Model.SelectedFighter.Age == -1000)
        {
            <h1 class="DNExist">Выбранный боец не найден.</h1>
        }
        else
        {
         
        @if (Model.SelectedFighter != null)
        {
                

            <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3">
                    @Model.SelectedFighter.Name.Substring(0, Math.Min(20, Model.SelectedFighter.Name.Length))
            </h1>
            <div class="tag-container">
                @if (Model.SelectedFighter.TagId1 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId1)
                        {
                            <span class="tag t1">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedFighter.TagId2 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId2)
                        {
                            <span class="tag t2">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedFighter.TagId3 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId3)
                        {
                            <span class="tag t3">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedFighter.TagId4 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId4)
                        {
                            <span class="tag t4">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedFighter.TagId5 != 2)
                {
                    @foreach (var tag in Model.AllTags)
                    {
                        @if (@tag.Id == Model.SelectedFighter.TagId5)
                        {
                            <span class="tag t5">@tag.Name</span>
                        }
                    }
                }
                @if (Model.SelectedFighter.TagId1 == 2 && Model.SelectedFighter.TagId2 == 2 && Model.SelectedFighter.TagId3 == 2 && Model.SelectedFighter.TagId4 == 2 && Model.SelectedFighter.TagId5 == 2)
                {
                    <b>ㅤㅤ</b>
                }
            </div>

            @if (!Model.SelectedFighter.Sex)
            {
                <p class="col-lg-8 mx-auto fs-5 text-start" style="color:white">
                    мужчина - @Model.SelectedFighter.Age
                </p>
            }
            else
            {
                <p class="col-lg-8 mx-auto fs-5 text-start" style="color:white">
                    женщина - @Model.SelectedFighter.Age
                </p>
            }

            <hr class="my-4">

            <div class="scroll_t">
                <p class="col-lg-8 mx-auto fs-5" style="color:white">
                    @Model.SelectedFighter.Skills
                </p>
            </div>

            <hr class="my-4">
        }
        else
        {
            <h1 class="DNExist">Выбранный боец не найден.</h1>
        }
        
        }

    </form>
    
    @if (Model.SelectedFighter != null && Model.SelectedFighter.Age != -1000)
    {
        <div class="likeDislike">
            <div class="d-inline-flex gap-2 mb-5 likeDislike1">
                <form asp-controller="Match" asp-action="Like" method="post">
                    <button type="submit" name="fighterId" value="@Model.SelectedFighter.Id" class="d-inline-flex align-items-center btn btn-success btn-lg px-4 rounded-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-hand-thumbs-up-fill" viewBox="0 0 16 16">
                            <path d="M6.956 1.745C7.021.81 7.908.087 8.864.325l.261.066c.463.116.874.456 1.012.965.22.816.533 2.511.062 4.51a10 10 0 0 1 .443-.051c.713-.065 1.669-.072 2.516.21.518.173.994.681 1.2 1.273.184.532.16 1.162-.234 1.733q.086.18.138.363c.077.27.113.567.113.856s-.036.586-.113.856c-.039.135-.09.273-.16.404.169.387.107.819-.003 1.148a3.2 3.2 0 0 1-.488.901c.054.152.076.312.076.465 0 .305-.089.625-.253.912C13.1 15.522 12.437 16 11.5 16H8c-.605 0-1.07-.081-1.466-.218a4.8 4.8 0 0 1-.97-.484l-.048-.03c-.504-.307-.999-.609-2.068-.722C2.682 14.464 2 13.846 2 13V9c0-.85.685-1.432 1.357-1.615.849-.232 1.574-.787 2.132-1.41.56-.627.914-1.28 1.039-1.639.199-.575.356-1.539.428-2.59z" />
                        </svg>
                    </button>
                </form>

                <form asp-controller="Match" asp-action="Dislike" method="post">
                    <button type="submit" name="fighterId" value="@Model.SelectedFighter.Id" class="d-inline-flex align-items-center btn btn-lg px-4 rounded-pill red disBut">
                        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-hand-thumbs-down-fill" viewBox="0 0 16 16">
                            <path d="M6.956 14.534c.065.936.952 1.659 1.908 1.42l.261-.065a1.38 1.38 0 0 0 1.012-.965c.22-.816.533-2.512.062-4.51q.205.03.443.051c.713.065 1.669.071 2.516-.211.518-.173.994-.68 1.2-1.272a1.9 1.9 0 0 0-.234-1.734c.058-.118.103-.242.138-.362.077-.27.113-.568.113-.856 0-.29-.036-.586-.113-.857a2 2 0 0 0-.16-.403c.169-.387.107-.82-.003-1.149a3.2 3.2 0 0 0-.488-.9c.054-.153.076-.313.076-.465a1.86 1.86 0 0 0-.253-.912C13.1.757 12.437.28 11.5.28H8c-.605 0-1.07.08-1.466.217a4.8 4.8 0 0 0-.97.485l-.048.029c-.504.308-.999.61-2.068.723C2.682 1.815 2 2.434 2 3.279v4c0 .851.685 1.433 1.357 1.616.849.232 1.574.787 2.132 1.41.56.626.914 1.28 1.039 1.638.199.575.356 1.54.428 2.591" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    }
</div>

<script>
    const openPopUpButton = document.getElementById('open_pop_up');
    const popUp = document.getElementById('pop_up');
    const closePopUpButton = document.getElementById('pop_up_close');
    const cancelPopUpButton = document.getElementById('pop_up_cancel');

    // Открываем popup при нажатии на кнопку
    openPopUpButton.addEventListener('click', function (event) {
        event.preventDefault();  // Отключаем стандартное поведение ссылки
        popUp.style.display = 'block';  // Показываем popup
    });

    // Закрываем popup при нажатии на кнопку закрытия
    closePopUpButton.addEventListener('click', function () {
        popUp.style.display = 'none';  // Скрываем popup
    });

    // Закрываем popup при нажатии на кнопку отмены
    cancelPopUpButton.addEventListener('click', function () {
        popUp.style.display = 'none';  // Скрываем popup
    });



    // Функция для удаления опции с value="2" из выпадающих списков
    function removeTagWithId2() {
        // Найдем все выпадающие списки с классом 'tagchos'
        const tagSelects = document.querySelectorAll('.tagchos');
        
        // Для каждого выпадающего списка
        tagSelects.forEach(select => {
            // Найдем опцию с value="2"
            const optionToRemove = select.querySelector('option[value="2"]');
            
            // Если такая опция существует, удалим ее
            if (optionToRemove) {
                select.removeChild(optionToRemove);
            }
        });
    }

    // Выполним функцию после загрузки страницы
    document.addEventListener('DOMContentLoaded', removeTagWithId2);
</script>